# Copy to .env and fill in. Never commit .env.

# Local: `npm run db:up` starts Postgres on port 5433 with these credentials.
DATABASE_URL=postgresql://proof2pay:proof2pay@localhost:5433/proof2pay

# Google Gemini, free tier (aistudio.google.com > Get API key). Free-tier prompts may be used by Google; demo data only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_MCP_URL=
PAYPAL_MCP_ACCESS_TOKEN=

ELASTIC_URL=
ELASTIC_API_KEY=

AG_STUDIO_LICENSE_KEY=
BRYNTUM_TRIAL=true

RENDER_WORKFLOWS_API_KEY=

APP_BASE_URL=http://localhost:3000
DEMO_MODE=true

# MSMED delayed-payment interest is 3x the RBI bank rate (annual %). 5.75 per rbi.org.in on 2026-11-02.
RBI_BANK_RATE_PCT=5.75
