# Copy to .env and fill in. Never commit .env.

# Local: `npm run db:up` starts Postgres on port 5433 with these credentials.
DATABASE_URL=postgresql://proof2pay:proof2pay@localhost:5433/proof2pay

ANTHROPIC_API_KEY=

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_MCP_URL=
PAYPAL_MCP_ACCESS_TOKEN=

ELASTIC_URL=
ELASTIC_API_KEY=

AG_STUDIO_LICENSE_KEY=
BRYNTUM_TRIAL=true

RENDER_WORKFLOWS_API_KEY=

APP_BASE_URL=http://localhost:3000
DEMO_MODE=true

# MSMED delayed-payment interest is 3x the RBI bank rate (annual %). Verify before the demo.
RBI_BANK_RATE_PCT=5.50
